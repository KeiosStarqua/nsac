{
  "$schema": "https://opencode.ai/config.json",
  // Folder này: .agents/bot/ceo — opencode tự tìm AGENTS.md (file đó nạp tự động),
  // nên HC-AGENTS.md và SCHEDULE.md nạp qua đây.
  // Local-dir plugin: server npm-install như một package (thiếu package.json là
  // failed to load). Dùng ABSOLUTE path — server resolve path tương đối theo cwd
  // của background service (observed: /home/keios), KHÔNG theo repo root, nên
  // ".agents/bot/ceo/plugins/..." trước đây luôn fail với ENOENT (xem err_8807a12e).
  "instructions": [
    ".agents/bot/ceo/*.md",
  ],
  // herdr-tab-status: tự flip symbol ●/○/◆ trên tab herdr của session theo
  // turn start/end (xem plugins/herdr-tab-status/index.ts). Chỉ chạy khi
  // HERDR_ENV=1 và HERDR_TAB_ID set; bỏ qua child session (hc/subagent).
  // Local-dir plugin phải có package.json (exports "." → ./index.ts) —
  // server npm-install plugin như một package, thiếu là failed to load.
  //
  // herdr-tab-reminder: inject lời nhắc BẮT BUỘC vào system instructions ở
  // mỗi lượt (context hook) — agent phải chạy `herdr tab get` và đảm bảo
  // label khớp việc đang làm (format `<symbol>:ceo-{index}-<slug>`, không
  // dấu cách) trước khi làm việc khác (xem plugins/herdr-tab-reminder/index.ts).
  "plugins": [
    "/home/keios/repos/mein/nsac/.agents/bot/ceo/plugins/herdr-tab-status",
    "/home/keios/repos/mein/nsac/.agents/bot/ceo/plugins/herdr-tab-reminder",
  ],
}
