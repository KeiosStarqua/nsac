{
  "$schema": "https://opencode.ai/config.json",
  // Folder này: .agents/bot/ceo — opencode tự tìm AGENTS.md (file đó nạp tự động),
  // nên HC-AGENTS.md và SCHEDULE.md nạp qua đây. Cài đặt tương đối resolve theo repo root
  // (nơi opencode chạy), KHÔNG theo thư mục chứa file config này.
  "instructions": [
    ".agents/bot/ceo/*.md",
  ],
  // herdr-tab-status: tự flip symbol ●/○/◆ trên tab herdr của session theo
  // turn start/end (xem plugins/herdr-tab-status/index.ts). Chỉ chạy khi
  // HERDR_ENV=1 và HERDR_TAB_ID set; bỏ qua child session (hc/subagent).
  // Local-dir plugin phải có package.json (exports "." → ./index.ts) —
  // server npm-install plugin như một package, thiếu là failed to load.
  "plugins": [
    ".agents/bot/ceo/plugins/herdr-tab-status",
  ],
}
